{
  "expo": {
    "name": "Dono Jaha",
    "slug": "dono-jaha",
    "scheme": "donojaha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FCFCFA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.donojaha.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FCFCFA"
      },
      "package": "com.donojaha.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Allow Dono Jaha to access your microphone for recording your authentic voice introduction and voice notes."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "a9bf2489-838c-4f80-b44a-dc7958cf7e0f"
      }
    }
  }
}
