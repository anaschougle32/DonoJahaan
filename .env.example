# Dono Jaha (D O N O   J A H A)
# Expo React Native Environment Configuration Template
# Copy this file to .env and provide your credentials.

# Supabase Public API Configuration (Safe for Mobile Client)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Application Settings
EXPO_PUBLIC_APP_NAME="Dono Jahaan"
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_ENABLE_MOCK_FALLBACK=true

# Indian SMS Provider Configuration (Edge Functions / Server-side only)
# Never expose provider secrets to the mobile client
INDIAN_SMS_PROVIDER=2factor # options: 2factor | msg91 | exotel
SMS_API_KEY=your_sms_api_key_here
SMS_SENDER_ID=DONOJA
